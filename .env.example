# Environment configuration template for Marketplace Crawler
# Copy this file to .env and configure your secrets

# Crawler Settings
CRAWLER_TARGET_NAME=MetropolisRealty
CRAWLER_MAX_PAGES=3
CRAWLER_CONCURRENCY=3
CRAWLER_CONNECT_TIMEOUT=15.0
CRAWLER_READ_TIMEOUT=45.0
CRAWLER_MAX_ATTEMPTS=5
CRAWLER_BACKOFF_CAP=60.0
CRAWLER_JITTER_MAX=1.5

# Anti-Bot & 429 Cooldown Settings
ENABLE_GLOBAL_429_COOLDOWN=true
GLOBAL_429_COOLDOWN_BASE_S=5.0
GLOBAL_429_COOLDOWN_MULTIPLIER=1.5
GLOBAL_429_COOLDOWN_CAP_S=30.0

# Google Sheets Integration
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SERVICE_ACCOUNT_JSON=config/service_account.json
GSHEETS_BATCH_SIZE=300
GSHEETS_RETRIES=5

# Telegram Alert Telemetry
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Signal Analytics
SHARP_DROP_PCT=5.0
